# PostgreSQL (aplicação). Suba um banco local com:
#   docker run -d --name pratocheio-pg -e POSTGRES_USER=pratocheio -e POSTGRES_PASSWORD=pratocheio -e POSTGRES_DB=pratocheio -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgres://pratocheio:pratocheio@localhost:5432/pratocheio

# Testes: banco DESCARTÁVEL (a suíte apaga as doações). Nunca aponte para o banco do piloto.
# No CI, DATABASE_URL já é o serviço descartável e é usado como fallback.
TEST_DATABASE_URL=postgres://pratocheio:pratocheio@localhost:5432/pratocheio
